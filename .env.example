# Copy to .env.local on your home host (never commit .env.local).
# Values: Supabase Dashboard → Project Settings → API, or your former Vercel env.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Local Supabase (homelab): run homelab\scripts\bootstrap-garden-local.ps1
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<from: npx supabase status -o env>
